{
  "rules": [
    {
      "description": "Change caps_lock to left_control if pressed with other keys, change caps_lock to escape if pressed alone.",
      "manipulators": [
        {
          "conditions": [
            {
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ],
              "type": "device_if"
            }
          ],
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_control"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "escape"
            }
          ],
          "type": "basic"
        }
      ]
    }
  ],
  "title": "CapsLock modifier"
}
