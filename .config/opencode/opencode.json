{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "model": "openai/gpt-6.1-sol#high"
    }
  },
  "experimental": {
    "todo": true
  },
  "lsp": {
    "nixd": {
      "command": [
        "nixd"
      ],
      "extensions": [
        ".nix"
      ]
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    }
  },
  "mcp": {
    "servers": {
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.com/v1/mcp?toolsets=all",
        "codemode": true
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "oauth": {
          "client_id": "1601185624273.8899143856786",
          "callback_port": 3118,
          "redirect_uri": "http://localhost:3118/callback"
        }
      }
    }
  },
  "model": "openai/gpt-6.1-sol",
  "permissions": [
    {
      "action": "*",
      "effect": "allow",
      "resource": "*"
    }
  ],
  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "settings": {
            "reasoningEffort": "high"
          },
          "variants": [
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            }
          ]
        }
      }
    }
  },
  "update": "disable",
  "websearch": {
    "provider": "exa"
  }
}
