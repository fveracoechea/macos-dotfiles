{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "model": "claude-agent/opus#high"
    },
    "super": {
      "model": "claude-agent/opus#high"
    },
    "worker": {
      "model": "claude-agent/opus#high"
    }
  },
  "compaction": {
    "buffer": "25%",
    "keep": {
      "tokens": 25000
    }
  },
  "experimental": {
    "todo": true
  },
  "formatter": true,
  "lsp": {
    "nixd": {
      "command": [
        "nixd"
      ],
      "extensions": [
        ".nix"
      ]
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    }
  },
  "mcp": {
    "servers": {
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.com/v1/mcp?toolsets=all",
        "codemode": true
      },
      "posthog": {
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp",
        "codemode": true
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "oauth": {
          "client_id": "1601185624273.8899143856786",
          "callback_port": 3118,
          "redirect_uri": "http://localhost:3118/callback"
        }
      }
    }
  },
  "model": "claude-agent/opus",
  "permissions": [
    {
      "action": "*",
      "effect": "allow",
      "resource": "*"
    }
  ],
  "providers": {
    "claude-agent": {
      "models": {
        "opus": {
          "settings": {
            "effort": "high"
          }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "settings": {
            "reasoningEffort": "high"
          },
          "variants": [
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            }
          ]
        }
      },
      "settings": {
        "compaction": {
          "type": "native"
        }
      }
    }
  },
  "update": "disable",
  "websearch": {
    "provider": "exa"
  }
}
