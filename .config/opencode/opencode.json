{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "model": "claude-agent/opus#high"
    },
    "super": {
      "description": "SuperAgent: supervises Operator work. Reads and researches, delegates edits to WorkerAgents.",
      "mode": "primary",
      "model": "claude-agent/opus#high",
      "system": "You are the SuperAgent. Before anything else in this session, load the super-agent skill with the skill tool and follow it.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "/tmp/operator-plans/*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "/private/tmp/operator-plans/*",
          "effect": "allow"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "sleep *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "bun test *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "bun run *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "bun dev *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "bun install *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "npm install *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "npm run *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "pkill *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "gh run rerun *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git commit *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git -C * commit *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git -C * push *",
          "effect": "deny"
        },
        {
          "action": "slack_slack_add_list_record",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "slack_slack_add_reaction",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "slack_slack_complete_file_upload",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "slack_slack_get_file_upload_url",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "slack_slack_create_canvas",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "slack_slack_create_conversation",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "slack_slack_create_list",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "slack_slack_schedule_message",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "slack_slack_update_canvas",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "slack_slack_update_list",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "slack_slack_update_list_record",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "experimental": {
    "todo": true
  },
  "lsp": {
    "nixd": {
      "command": [
        "nixd"
      ],
      "extensions": [
        ".nix"
      ]
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    }
  },
  "mcp": {
    "servers": {
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.com/v1/mcp?toolsets=all",
        "codemode": true
      },
      "posthog": {
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp",
        "codemode": true
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "oauth": {
          "client_id": "1601185624273.8899143856786",
          "callback_port": 3118,
          "redirect_uri": "http://localhost:3118/callback"
        }
      }
    }
  },
  "model": "claude-agent/opus",
  "permissions": [
    {
      "action": "*",
      "effect": "allow",
      "resource": "*"
    }
  ],
  "providers": {
    "claude-agent": {
      "models": {
        "opus": {
          "settings": {
            "effort": "high"
          }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "settings": {
            "reasoningEffort": "high"
          },
          "variants": [
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            }
          ]
        }
      }
    }
  },
  "update": "disable",
  "websearch": {
    "provider": "exa"
  }
}
