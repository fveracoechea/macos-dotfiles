{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "model": "openai/gpt-6.1-sol",
      "variant": "high"
    }
  },
  "autoupdate": false,
  "lsp": {
    "biome": {
      "command": [
        "biome",
        "lsp-proxy"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".json",
        ".jsonc",
        ".css",
        ".html",
        ".graphql",
        ".vue",
        ".svelte",
        ".astro"
      ]
    },
    "lua_ls": {
      "command": [
        "lua-language-server"
      ],
      "extensions": [
        ".lua"
      ]
    },
    "oxfmt": {
      "command": [
        "oxfmt",
        "--lsp"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".toml",
        ".json",
        ".jsonc",
        ".json5",
        ".yaml",
        ".yml",
        ".html",
        ".vue",
        ".handlebars",
        ".hbs",
        ".css",
        ".scss",
        ".less",
        ".graphql",
        ".md"
      ]
    },
    "oxlint": {
      "command": [
        "oxlint",
        "--lsp"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".vue",
        ".svelte",
        ".astro"
      ]
    },
    "stylelint": {
      "command": [
        "stylelint-language-server",
        "--stdio"
      ],
      "extensions": [
        ".css",
        ".scss",
        ".less",
        ".html",
        ".vue",
        ".astro"
      ]
    }
  },
  "mcp": {
    "grep": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "model": "openai/gpt-6.1-sol",
  "permission": {
    "*": "allow"
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": {
          "options": {
            "reasoning": {
              "effort": "high"
            }
          },
          "variants": {
            "high": {
              "reasoning": {
                "effort": "high"
              }
            }
          }
        }
      },
      "options": {
        "extraBody": {
          "provider": {
            "allow_fallbacks": true,
            "data_collection": "deny",
            "only": [
              "baseten",
              "novita",
              "fireworks"
            ],
            "sort": "throughput",
            "zdr": true
          }
        }
      }
    }
  }
}
