{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "diffs": {
    "wrap": "none",
    "view": "unified"
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "session": {
    "scrollbar": true,
    "sidebar": "hide",
    "thinking": "hide",
    "markdown": "rendered"
  },
  "theme": {
    "mode": "system",
    "name": "system"
  },
  "tabs": {
    "mode": "auto",
    "indicators": "status"
  }
}
